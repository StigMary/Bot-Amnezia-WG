[Unit]
Description=VPN Management Bot (KJZNNETx)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=vpnuser
WorkingDirectory=/home/vpnuser/vpn_bot
ExecStartPre=/bin/mkdir -p /home/vpnuser/vpn_bot/data
ExecStart=/home/vpnuser/vpn_bot/venv/bin/python bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
