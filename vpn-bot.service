[Unit]
Description=VPN Telegram Bot v3.0
After=network.target docker.service

[Service]
Type=simple
User=vpnuser
WorkingDirectory=/home/vpnuser/vpn_bot
# Виртуальное окружение для изоляции зависимостей (см. requirements.txt)
ExecStart=/home/vpnuser/vpn_bot/.venv/bin/python bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
