# Токен бота от @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram ID главного администратора (узнать через @userinfobot)
ADMIN_ID=123456789

# Секретный API-ключ для внешнего API доступа к WebApp
ADMIN_API_KEY=generate_random_secret_string_here

# ID закрытой группы Telegram для проверки подписки абонента (0 если отключено)
GROUP_CHAT_ID=0

# URL WebApp (домен или Cloudflare Tunnel) для кнопки в боте
WEBHOOK_URL=https://vpn-admin.example.com

# ------------------------------------------------------------------------------
# VPN-СЕРВЕРЫ (НОДЫ)
# Поддерживается любое количество серверов (1, 2, 3, 4 и более)!
# Управление через CLI: python3 manage.py add-node
#
# Формат: НАЗВАНИЕ | ХОСТ (local или IP) | SSH_ПОРТ | USER | КОНТЕЙНЕР | ИНТЕРФЕЙС
# ------------------------------------------------------------------------------
NODE_1="🇷🇺 RU Server (Main)|local|22|root|amnezia-awg2|awg0"
# NODE_2="🇸🇪 SE Exit-Node|198.51.100.20|22|root|amnezia-awg|awg0"
# NODE_3="🇳🇱 NL Gateway|203.0.113.10|22|root|amnezia-awg|awg0"
# NODE_4="🇩🇪 DE Server|192.0.2.50|2222|admin|amnezia-awg|awg0"

# --- Название проекта и бренда ---
PROJECT_NAME=KznNET

# --- Реквизиты и тарифы ---
